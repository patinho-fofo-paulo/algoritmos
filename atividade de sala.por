programa
{
    funcao inicio()
    {
        // Declaração das variáveis
        cadeia nome
        inteiro nivelPoder
        real velocidadeMaxima
        logico habilidadeVoo

        // Atribuição dos valores
        nome = "Cavaleiro da Lua"
        nivelPoder = 85
        velocidadeMaxima = 120.5
        habilidadeVoo = falso

        // Exibição da ficha técnica
        escreva("===== FICHA TÉCNICA DO SUPER-HERÓI =====\n")
        escreva("Nome: ", nome, "\n")
        escreva("Nível de Poder: ", nivelPoder, "\n")
        escreva("Velocidade Máxima: ", velocidadeMaxima, " km/h\n")
        escreva("Habilidade de Voo: ", habilidadeVoo, "\n")
    }
}
